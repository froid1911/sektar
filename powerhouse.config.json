{
  "$schema": "https://raw.githubusercontent.com/powerhouse-inc/powerhouse/main/packages/shared/clis/source-config.schema.json",
  "documentModelsDir": "./document-models",
  "editorsDir": "./editors",
  "processorsDir": "./processors",
  "subgraphsDir": "./subgraphs",
  "studio": {
    "port": 6540
  },
  "reactor": {
    "port": 7540
  },
  "packages": [],
  "packageRegistryUrl": "https://registry.dev.vetra.io",
  "connect": {
    "branding": {
      "appName": "Sektar",
      "icon": "./icons/sektar_app.png",
      "loader": {
        "src": "./icons/sektar_app_192x192.png",
        "animation": "pulse",
        "size": 88
      }
    },
    "app": {
      "logLevel": "info",
      "basePath": "/",
      "offline": true,
      "studioMode": false
    },
    "ai": {
      "assistantEnabled": false
    },
    "packages": {
      "externalEnabled": true,
      "liveReload": false
    },
    "drives": {
      "defaultDrives": []
    },
    "renown": {
      "url": "https://www.renown.id",
      "networkId": "eip155",
      "chainId": 1
    },
    "sentry": {
      "dsn": null,
      "env": "dev",
      "tracing": false
    },
    "openPanel": {
      "clientId": "",
      "trackUiEvents": true,
      "trackOperations": true
    },
    "instance": {
      "namespace": null,
      "reactorWorker": false,
      "multiReactor": false
    },
    "reactor": {
      "featureFlags": {
        "documentDecisions": false,
        "authEnforcement": false,
        "authGroups": false,
        "authConditions": false
      },
      "createSignaturePolicy": "v2-required",
      "unsupportedStoredDocuments": "refuse"
    },
    "pwa": {
      "manifest": {
        "theme_color": "#1F3A2E",
        "background_color": "#F5F7F3"
      }
    }
  },
  "vetra": {
    "connectPort": 2540
  },
  "assistant": {
    "port": 4910
  },
  "ai": {
    "demoKeyFile": "../openrouter-demo-key.txt"
  },
  "workflows": {
    "oauthApps": [
      {
        "id": "sektar-google",
        "clients": {
          "desktop": "../client_secret_sektar_desktop-app.json",
          "web": "../client_secret_sektar-web-app.json"
        }
      }
    ]
  }
}
